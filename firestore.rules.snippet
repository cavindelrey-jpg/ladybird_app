// ─────────────────────────────────────────────────────────────────────────
// SNIPPET — merge into your existing firestore.rules (inside `match
// /databases/{database}/documents { ... }`). Not a full rules file, since
// your current one wasn't in this patch — copy these two match blocks in
// alongside your existing ones, and delete any prior rules for these two
// collections so they don't conflict.
// ─────────────────────────────────────────────────────────────────────────

// serials/{code}
// Client may only READ (needed for SerialRepository.preview() to show
// branding before account creation, and for countsFor() on admin
// dashboards). All writes (claim, generate, revoke, release) now go
// through Cloud Functions using the Admin SDK, which bypasses these rules
// entirely — so "no client writes" here is a real enforcement boundary,
// not just a UI convention.
match /serials/{code} {
  allow read: if request.auth != null;
  allow write: if false;
}

// institutions/{institutionId}
// Any signed-in user may read (branding must be visible before the user
// has an institutionId of their own, e.g. during serial preview). Writes
// restricted to admins of that same institution, or a superAdmin.
match /institutions/{institutionId} {
  allow read: if request.auth != null;
  allow write: if request.auth != null &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
      ['schoolAdmin', 'departmentAdmin', 'superAdmin'] &&
    (
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin' ||
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == institutionId
    );
}
